{
  "name": "earthverse-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace frontend --",
    "frontend:dev": "npm run dev --workspace frontend --",
    "build": "npm run build --workspace frontend",
    "frontend:build": "npm run build --workspace frontend",
    "preview": "npm run preview --workspace frontend",
    "deploy": "npx vercel --prod",
    "backend:install": "python3.12 -m venv backend/.venv312 && backend/.venv312/bin/python -m pip install -r backend/requirements.txt",
    "backend:dev": "cd backend && .venv312/bin/python -m uvicorn app.main:app --reload --host 127.0.0.1 --port 8000"
  }
}
