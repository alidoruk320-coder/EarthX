# Copy this file to backend/.env and fill in your Earth Engine service account.
# Keep the service account key file private and out of version control.
GEE_SERVICE_ACCOUNT_EMAIL=twinearth-service@your-project-id.iam.gserviceaccount.com
GEE_PRIVATE_KEY_PATH=./gee-service-account.json
# For hosted services where a key file cannot be mounted, use GEE_PRIVATE_KEY instead.
# Put the private key in one environment variable and encode line breaks as \\n.
# GEE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\\n...
GEE_PROJECT_ID=your-project-id

# CORS için frontend adresleri
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
